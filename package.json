{
  "name": "expo-hinge",
  "version": "0.1.0",
  "description": "Expo module exposing hinge posture, angle, and fold geometry for foldable devices (iPhone Duo, Android foldables)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-hinge",
    "foldable",
    "hinge",
    "iphone-duo",
    "posture"
  ],
  "repository": "https://github.com/azizbecha/expo-hinge",
  "bugs": {
    "url": "https://github.com/azizbecha/expo-hinge/issues"
  },
  "author": "Aziz Becha <aziz07becha@gmail.com> (https://github.com/azizbecha)",
  "license": "MIT",
  "homepage": "https://github.com/azizbecha/expo-hinge#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.25",
    "happy-dom": "^20.14.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.82.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
